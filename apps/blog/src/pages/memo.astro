---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { cms } from "@/lib/cms";
import {
  memoTextWithoutTags,
  openStreetMapLocationUrl
} from "@cf-blog/contracts";

const PAGE_SIZE = 20;
const MEMO_TAG_PATTERN = /^[\p{L}\p{N}_-]{1,40}$/u;
const pageParam = Astro.url.searchParams.get("page");
const tagParam = Astro.url.searchParams.get("tag");
const tag = tagParam ?? "";
const page = pageParam === null ? 1 : Number(pageParam);
const offset = (page - 1) * PAGE_SIZE;

function memoHref(targetPage = 1): string {
  const params = new URLSearchParams();
  if (tag) params.set("tag", tag);
  if (targetPage > 1) params.set("page", String(targetPage));
  const query = params.toString();
  return query ? `/memo?${query}` : "/memo";
}

if (
  (tagParam !== null && !MEMO_TAG_PATTERN.test(tagParam)) ||
  (pageParam !== null && !/^[1-9]\d*$/.test(pageParam)) ||
  !Number.isSafeInteger(page) ||
  !Number.isSafeInteger(offset) ||
  page < 1 ||
  pageParam === "1"
) {
  return Astro.redirect(
    tagParam !== null && MEMO_TAG_PATTERN.test(tagParam) ? memoHref() : "/memo",
    302
  );
}

const site = await cms.site();

if (!site.enableMemos) {
  return new Response("Not found", { status: 404 });
}

const pageMemos = await cms.memos(PAGE_SIZE + 1, offset, tag || undefined);

if (page > 1 && pageMemos.length === 0) {
  return Astro.redirect(memoHref(), 302);
}

const memos = pageMemos.slice(0, PAGE_SIZE);
const hasMemoImages = memos.some((memo) => memo.images.length > 0);
const hasPreviousPage = page > 1;
const hasNextPage = pageMemos.length > PAGE_SIZE;
const previousPageHref = memoHref(page - 1);
const nextPageHref = memoHref(page + 1);
const author = site.authorName.trim() || site.title;
const authorMark = Array.from(author.trim())[0] ?? "M";

function formatMemoDate(value: string): string {
  const options: Intl.DateTimeFormatOptions = {
    year: "numeric",
    month: "long",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit"
  };
  try {
    return new Intl.DateTimeFormat(site.locale, {
      ...options,
      timeZone: site.timezone
    }).format(new Date(value));
  } catch {
    return new Intl.DateTimeFormat(site.locale, options).format(new Date(value));
  }
}

function providerLabel(provider: string): string {
  return {
    youtube: "YouTube",
    bilibili: "Bilibili",
    vimeo: "Vimeo",
    direct: "视频"
  }[provider] ?? "视频";
}
---

<BaseLayout
  site={site}
  title={`短文${tag ? ` · #${tag}` : ""}${page > 1 ? ` · 第 ${page} 页` : ""}`}
  description={tag
    ? `${site.title} 中带有 #${tag} 标签的短文`
    : site.memoDescription || `${site.title} 的短文与即时想法`}
>
  <section class="memo-page">
    <header class="section-hero memo-hero">
      <p class="kicker">Memos</p>
      <h1>短文</h1>
      {site.memoDescription && <p>{site.memoDescription}</p>}
      {tag && (
        <div class="memo-filter" aria-label={`当前按标签 ${tag} 筛选`}>
          <span>标签 <strong>#{tag}</strong></span>
          <a href="/memo">查看全部短文</a>
        </div>
      )}
    </header>

    <div class="memo-timeline" aria-label="短文时间轴">
      {memos.map((memo) => {
        const timestamp = memo.publishedAt ?? memo.createdAt;
        const visibleContent = memoTextWithoutTags(memo.content);
        return (
          <article class="memo-entry">
            <div class="memo-rail" aria-hidden="true"><span /></div>
            <div class="memo-card">
              <header class="memo-card-header">
                <div class="memo-public-author">
                  <span aria-hidden="true">{authorMark}</span>
                  <div>
                    <strong>{author}</strong>
                    <time datetime={timestamp}>{formatMemoDate(timestamp)}</time>
                  </div>
                </div>
                {memo.isPinned && <span class="memo-pinned">置顶</span>}
              </header>
              {visibleContent && <p class="memo-content">{visibleContent}</p>}
              {(memo.images.length > 0 || memo.videos.length > 0) && (
                <div class="memo-media">
                  {memo.images.length > 0 && (
                    <div
                      class={`memo-gallery memo-gallery-${memo.images.length}`}
                      data-memo-gallery
                    >
                      {memo.images.map((image) => (
                        <a
                          data-memo-image
                          href={image.url}
                          target="_blank"
                          rel="noreferrer"
                        >
                          <img
                            alt={image.alt || "短文图片"}
                            height={image.height ?? undefined}
                            loading="lazy"
                            src={image.url}
                            width={image.width ?? undefined}
                          />
                        </a>
                      ))}
                    </div>
                  )}
                  {memo.videos.map((video) => (
                    <figure class="memo-video">
                      <div class="memo-video-frame">
                        {video.preview.kind === "iframe" ? (
                          <iframe
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            src={video.preview.url}
                            title={`${providerLabel(video.provider)} 视频预览`}
                          />
                        ) : (
                          <video controls preload="metadata">
                            <source src={video.preview.url} type={video.preview.mimeType} />
                          </video>
                        )}
                      </div>
                      <figcaption>
                        <span>{providerLabel(video.provider)}</span>
                        <a href={video.sourceUrl} target="_blank" rel="noreferrer">打开原链接</a>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              )}
              {(memo.location || memo.tags.length > 0) && (
                <div class="memo-taxonomy">
                  {memo.location && (
                    <a
                      class="memo-location"
                      href={openStreetMapLocationUrl(memo.location)}
                      target="_blank"
                      rel="noreferrer"
                    >
                      <span aria-hidden="true">⌖</span>
                      {memo.location.name}
                    </a>
                  )}
                  {memo.tags.length > 0 && (
                    <div class="memo-tags" aria-label="短文标签">
                      {memo.tags.map((memoTag) => (
                        <a
                          aria-current={tag.toLocaleLowerCase() === memoTag.toLocaleLowerCase()
                            ? "page"
                            : undefined}
                          href={`/memo?tag=${encodeURIComponent(memoTag)}`}
                        >
                          #{memoTag}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
          </article>
        );
      })}
      {memos.length === 0 && (
        <p class="empty-state">
          {tag ? <>还没有使用 <strong>#{tag}</strong> 的公开短文。</> : "还没有公开短文。"}
        </p>
      )}
    </div>

    {(hasPreviousPage || hasNextPage) && (
      <nav class="pagination memo-pagination" aria-label="短文分页">
        <div class="pagination-side">
          {hasPreviousPage && <a href={previousPageHref} rel="prev">← 上一页</a>}
        </div>
        <span aria-current="page">第 {page} 页</span>
        <div class="pagination-side pagination-next">
          {hasNextPage && <a href={nextPageHref} rel="next">下一页 →</a>}
        </div>
      </nav>
    )}
  </section>

  {hasMemoImages && (
    <dialog class="memo-lightbox" aria-label="图片预览" data-memo-lightbox>
      <div class="memo-lightbox-shell">
        <button
          class="memo-lightbox-close"
          type="button"
          aria-label="关闭图片预览"
          data-memo-lightbox-close
        >×</button>
        <button
          class="memo-lightbox-nav memo-lightbox-previous"
          type="button"
          aria-label="上一张图片"
          data-memo-lightbox-previous
        >‹</button>
        <figure data-memo-lightbox-stage>
          <img alt="" draggable="false" data-memo-lightbox-image />
          <figcaption>
            <span data-memo-lightbox-caption></span>
            <span aria-live="polite" data-memo-lightbox-counter></span>
          </figcaption>
        </figure>
        <button
          class="memo-lightbox-nav memo-lightbox-next"
          type="button"
          aria-label="下一张图片"
          data-memo-lightbox-next
        >›</button>
      </div>
    </dialog>
  )}
</BaseLayout>

{hasMemoImages && <script is:inline src="/scripts/memo.js"></script>}
