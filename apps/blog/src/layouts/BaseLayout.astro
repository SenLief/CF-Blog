---
import type { SiteSettings } from "@cf-blog/contracts";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import "@/styles/global.css";

interface Props {
  site: SiteSettings;
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  article?: boolean;
  noindex?: boolean;
}

const {
  site,
  title,
  description = site.description,
  image = site.seoImageUrl,
  canonical = Astro.url.href,
  article = false,
  noindex = false
} = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
---

<!doctype html>
<html lang={site.locale} data-default-theme={site.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.accent} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    {site.faviconUrl && <link rel="icon" href={site.faviconUrl} />}
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <style define:vars={{ accent: site.accent }}></style>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("cf-blog-theme");
        const fallback = document.documentElement.dataset.defaultTheme;
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        } else if (fallback === "light" || fallback === "dark") {
          document.documentElement.dataset.theme = fallback;
        } else {
          document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }
      })();
    </script>
  </head>
  <body>
    <div class="page-shell">
      <Header site={site} />
      <main>
        <slot />
      </main>
      <Footer site={site} />
    </div>
  </body>
</html>
