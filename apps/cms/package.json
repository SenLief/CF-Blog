{
  "name": "@cf-blog/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && wrangler deploy --minify",
    "dev:client": "vite",
    "dev:worker": "wrangler dev --port 8787 --var ENVIRONMENT:development --var BLOG_URL:http://localhost:4321 --var MEDIA_BASE_URL:http://localhost:4321/media",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "types": "wrangler types ./worker-configuration.d.ts"
  },
  "dependencies": {
    "@cf-blog/contracts": "workspace:*",
    "@cf-blog/markdown": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "agents": "^0.28.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.5"
  }
}
